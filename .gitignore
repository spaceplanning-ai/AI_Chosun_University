node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.env*.local
.DS_Store
.smoke/
.verify/

# CSV는 편집용 산출물이다. 원본은 src/data/*.json 이므로 저장소에 담지 않는다.
packages/core/data-csv/
packages/core/.build-scripts/
packages/core/.build-tests/
dist/

# 시각 검수 캡처 원본은 실행할 때마다 새로 만든다 (npm run shots).
# 다만 문서에 실리는 줄인 그림(docs:shots)은 담는다 — 이것이 없으면 요구사항
# 정의서를 다시 만들 수 없고, 그러자고 개발 서버부터 띄우게 된다.
docs/screenshots/*
!docs/screenshots/doc/

# 캡처 묶음은 저장소에 이미 있는 그림을 봉투에 담은 것이다 (npm run docs:zip).
docs/*.zip
